#include "i2s_init.h"
#include "usart_init.h"
#include <math.h>
#include <stdio.h>

#ifndef PI
#define PI 3.14159265359f
#endif

I2S_HandleTypeDef hi2s = {0};
DMA_HandleTypeDef hdma_spi3_tx = {0};
uint32_t audio_buffer[AUDIO_TOTAL_FRAMES];

static float phase = 0.0f;
// static const float phase_inc = 1000.0f / 44100.0f; /* 1 кГц / Fs */
static const float phase_inc = 1000.0f / 48000.0f; /* 1 кГц / Fs */
// static const float phase_inc = 1000.0f / 96000.0f; /* 1 кГц / Fs */

// 16 bit
static void fill_sine(uint32_t *buf, uint16_t stereo_frames) {
  for (uint16_t i = 0; i < stereo_frames; i++) {
    // int16_t val = (int16_t)(sinf(2.0f * PI * phase) * 32767.0f);
    int16_t val;
    SIN_VALUE(16, val);
    uint32_t sample =
        ((uint32_t)(uint16_t)val << 16) | (uint16_t)val; // L=R=16-bit

    buf[i] = sample; // одно uint32_t = два 16-bit канала

    phase += phase_inc;
    if (phase >= 1.0f)
      phase -= 1.0f;
  }
}

