  "description": "A source xPack with <your-description-here>",
  "main": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<user-id>/STM32F4-Bare-Metal-Guide.git"
  },
  "homepage": "https://github.com/<user-id>/STM32F4-Bare-Metal-Guide/",
